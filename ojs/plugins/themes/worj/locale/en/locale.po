msgid "plugins.themes.worj.name"
msgstr "World Open Research Journal Theme"

msgid "plugins.themes.worj.description"
msgstr "Child theme of the default theme for World Open Research Journal."

msgid "plugins.themes.worj.menu"
msgstr "Menu"

msgid "plugins.themes.worj.sidebar"
msgstr "Sidebar"

msgid "plugins.themes.worj.footerNav"
msgstr "Footer"

msgid "plugins.themes.worj.publishedWith"
msgstr "Published with Open Journal Systems"

msgid "plugins.themes.worj.makeSubmission"
msgstr "Make a Submission"

msgid "plugins.themes.worj.currentIssue"
msgstr "Current Issue"

msgid "plugins.themes.worj.aboutMore"
msgstr "Read more about the journal"

msgid "plugins.themes.worj.awardsTitle"
msgstr "Research Awards"

msgid "plugins.themes.worj.awardsLink"
msgstr "About the awards"

msgid "plugins.themes.worj.option.showAwardsCard.label"
msgstr "Research Awards card"

msgid "plugins.themes.worj.option.showAwardsCard.description"
msgstr "Shows a Research Awards call-out on the homepage. Turn this on only after the Awards page exists at /awards."

msgid "plugins.themes.worj.option.showAwardsCard.option"
msgstr "Show the Research Awards card on the homepage."

msgid "plugins.themes.worj.option.omitIssnLine.label"
msgstr "ISSN line in the footer"

msgid "plugins.themes.worj.option.omitIssnLine.description"
msgstr "While the journal has no ISSN the footer shows a visible placeholder. Turn this on only for a journal that launches without an ISSN: the line is then left out until one is entered in the journal settings."

msgid "plugins.themes.worj.option.omitPublisherLine.label"
msgstr "Publisher line in the footer"

msgid "plugins.themes.worj.option.omitPublisherLine.description"
msgstr "While the journal has no publisher name the footer shows a visible placeholder. Turn this on only for a journal whose publisher is not stated: the line is then left out until a name is entered in the journal settings."

msgid "plugins.themes.worj.option.omitPublisherLine.option"
msgstr "Leave the publisher line out of the footer while there is no publisher name."

msgid "plugins.themes.worj.option.omitIssnLine.option"
msgstr "Leave the ISSN line out of the footer while there is no ISSN."

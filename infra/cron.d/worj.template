# World Open Research Journal: scheduled jobs (installed as /etc/cron.d/worj, owner root, mode 644).
# Values between double at-signs are filled at provisioning. Times are SERVER time.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Nightly encrypted backup. backup.sh takes its own lock, raises its own alert on failure (FAILED marker, syslog,
# WORJ_ALERT_CMD) and writes /var/backups/worj/last-success for an external heartbeat to watch.
17 2 * * * root @@INSTALL_DIR@@/worj-backup --env /etc/worj/backup.env >>/var/log/worj-backup.log 2>&1

# Refresh Cloudflare's published IP ranges (real client address). On any failure the previous file is kept.
43 3 * * 1 root @@INSTALL_DIR@@/worj-update-cloudflare-ips --out @@REALIP_CONF@@ >>/var/log/worj-cloudflare-ips.log 2>&1

# OJS background work: the built-in web runners are left ON (the shipped job_runner and task_runner defaults),
# so no OJS cron line is installed here. Moving to cron (php lib/pkp/tools/scheduler.php run) is an
# operator decision documented in docs/DEPLOY.md and was not tested.

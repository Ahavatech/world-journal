# Settings for scripts/backup.sh, installed as /etc/worj/backup.env (owner root, mode 600, NEVER in git).
# Nothing secret belongs here: the database password lives in the separate root-only defaults file below, and the
# server holds ONLY the public age key. The private key stays with the client; do not copy it to this machine.
WORJ_DB_NAME=worj
WORJ_DB_DEFAULTS=/etc/worj/mysql-backup.cnf        # [client] user= password= host= ; mode 600
WORJ_FILES_DIR=/var/lib/worj/files                  # OJS files_dir (private submission files)
WORJ_PUBLIC_DIR=/var/www/worj/public
WORJ_CONFIG=/var/www/worj/config.inc.php
WORJ_BACKUP_DIR=/var/backups/worj
WORJ_AGE_RECIPIENT=age1REPLACE_WITH_THE_CLIENTS_PUBLIC_KEY
WORJ_RCLONE_REMOTE=worj-backup:REPLACE-bucket/worj  # client-owned storage; enable versioning or object lock there
WORJ_RETAIN_DAILY=14
WORJ_RETAIN_WEEKLY=8
# Called on any failure with the message on standard input, for example a mail or webhook command:
# WORJ_ALERT_CMD='/usr/local/sbin/worj-alert'

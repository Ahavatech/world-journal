# Settings for scripts/provision-ubuntu.sh, installed as /etc/worj/provision.env (owner root, mode 600, NEVER in git).
# Secrets in this file (ADMIN_PASSWORD, SMTP_PASSWORD) exist only for the run: DELETE THE ADMIN_PASSWORD LINE
# afterwards. The salt, the API key secret and the database password are NOT here: they are generated by the script.
HOST=journal.example.org                    # main host (the other one redirects to it; the certificate covers both)
ALT_HOST=www.journal.example.org
TIME_ZONE=REPLACE_WITH_AN_IANA_ZONE         # the client's choice, never assumed (for example Africa/Lagos)
OPERATOR_USER=REPLACE_WITH_THE_OPERATOR     # the account you log in with over SSH
ADMIN_USERNAME=REPLACE_NOT_admin            # a NON-default administrator name (admin, root, ojs ... are refused)
ADMIN_EMAIL=REPLACE_WITH_A_ROLE_ADDRESS
# ADMIN_PASSWORD=...                        # optional here; if absent the script prompts once (never on a command line)
DB_NAME=worj
DB_USER=worj
WEBROOT=/var/www/worj
FILES_DIR=/var/lib/worj/files               # OUTSIDE the web root
OJS_SRC=/opt/worj-src/ojs-core              # an OJS tree fetched by scripts/fetch-ojs.sh (pinned, checksum-verified)
THEME_SRC=/opt/worj-src/ojs/plugins/themes/worj
CERT_METHOD=origin                          # origin (Cloudflare Origin CA files you place) or certbot (HTTP-01)
CERT_FULLCHAIN=/etc/ssl/worj/fullchain.pem  # origin: these two files must exist before the nginx stage
CERT_KEY=/etc/ssl/worj/privkey.pem
CERTBOT_EMAIL=
HSTS_MAX_AGE=300                            # raise in stages by hand; no preload at launch
SMTP_SERVER=REPLACE
SMTP_PORT=587
SMTP_AUTH=tls
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE                       # a provider-issued app password or API credential, never a personal mailbox password
AGE_RECIPIENT=age1REPLACE_WITH_THE_CLIENTS_PUBLIC_KEY
RCLONE_REMOTE=worj-backup:REPLACE-bucket/worj
SSH_PORT=22
FIREWALL_CLOUDFLARE_ONLY=no                 # yes only after the site works behind Cloudflare (it blocks direct-IP testing)
# CLOUDFLARE_SOURCE=https://www.cloudflare.com   # tests only: a local fixture

; World Open Research Journal: PHP settings for OJS 3.5 on PHP-FPM (generated into /etc/php/8.3/fpm/conf.d/99-worj.ini)
; Value between double at-signs is filled at provisioning from the operator env file (the zone is the client's choice, never assumed).
date.timezone = @@TIME_ZONE@@

; PDF and dataset uploads: keep these equal to nginx client_max_body_size (64m)
upload_max_filesize = 64M
post_max_size = 66M
max_file_uploads = 20
memory_limit = 256M
max_execution_time = 120
max_input_time = 120

; do not advertise PHP, do not print errors to visitors
expose_php = Off
display_errors = Off
display_startup_errors = Off
log_errors = On

; sessions: cookies only over HTTPS, not readable by scripts
session.cookie_secure = 1
session.cookie_httponly = 1
session.use_strict_mode = 1
session.use_only_cookies = 1
session.cookie_samesite = Lax

; opcache: revalidate every 60 s so a theme or plugin change shows up within a minute
opcache.enable = 1
opcache.memory_consumption = 128
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 10000
opcache.validate_timestamps = 1
opcache.revalidate_freq = 60

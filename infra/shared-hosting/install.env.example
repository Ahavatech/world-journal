# Settings for scripts/install-shared.sh, run on YOUR machine (not on the host). Copy to .env.shared (git-ignored; mode 600)
# and fill in. The file holds secrets: never commit it, never paste it in a chat or a ticket.
# Values are plain KEY=VALUE lines (no quotes, no spaces around =).

# --- the site (not secret)
HOST=worldopenresearchjournal.com            # the canonical host: no www, no https://
TIME_ZONE=REPLACE_WITH_AN_IANA_ZONE          # the client's choice, never assumed (for example Africa/Lagos)

# --- the SSH login (hPanel > Advanced > SSH Access: enable it, add your public key). The key stays in ~/.ssh or your agent.
SSH_TARGET=REPLACE_user@host                 # for example u123456789@203.0.113.10
SSH_PORT=REPLACE_PORT                        # shown on the same hPanel page (Hostinger uses a non-standard port)
SSH_KEY=                                     # optional path to the private key file; empty = ssh's own defaults

# --- where things live on the host (read them with `pwd` after logging in; do not guess the account id)
REMOTE_ROOT=REPLACE_/home/uXXXX/domains/worldopenresearchjournal.com
# the web root is $REMOTE_ROOT/public_html; the private files go in $REMOTE_ROOT/worj-files (ABOVE the web root)

# --- the database (hPanel > Databases > Management: create a database and a user; MariaDB host is localhost)
DB_NAME=REPLACE_DB_NAME
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD              # SECRET

# --- the first administrator (a non-default username; the password must be changed at the first login)
ADMIN_USERNAME=REPLACE_ADMIN_USERNAME
ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_AT_LEAST_12_CHARACTERS   # SECRET; removed from the file by the installer once it has been used

# --- mail (the mailbox's SMTP settings from hPanel > Emails; never the built-in PHP mail: capped at 100 a day)
SMTP_SERVER=REPLACE_SMTP_SERVER
SMTP_PORT=REPLACE_PORT
SMTP_AUTH=ssl                                # ssl or tls, as the mailbox page says
SMTP_USERNAME=REPLACE_MAILBOX_ADDRESS
SMTP_PASSWORD=REPLACE_MAILBOX_PASSWORD       # SECRET

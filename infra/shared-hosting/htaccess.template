# World Open Research Journal: .htaccess for OJS 3.5 on shared hosting (LiteSpeed reads Apache rules).
# Rendered by scripts/render-template.py (values on stdin) into public_html/.htaccess by scripts/build-release.sh.
# Translates infra/nginx/*. Nothing secret is in this file. Value between double at-signs is filled at build time.
# UNVERIFIED (not run on the host): tested against a stand-in Apache (scripts/test-htaccess-harness.sh), not LiteSpeed.
# The Day-0 kit (infra/shared-hosting/day0-kit) shows on the real host which of these directives it honours.

DirectoryIndex index.php
Options -Indexes
ServerSignature Off
ErrorDocument 404 /_errors/404.html

# --- security headers (HSTS starts short; a human raises it in stages, no preload, no includeSubDomains) ---
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=@@HSTS_MAX_AGE@@"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
# While the site is closed (ROBOTS_MODE=closed) ask crawlers to index nothing; at launch this line is a comment.
@@ROBOTS_HEADER_LINE@@
# Report-only: observation, not protection. Backend pages (Vue admin UI) get no policy: not measured.
SetEnvIf Request_URI "^(/index\.php)?/[^/]+/(management|workflow|submission|dashboard|stats|tasks|api)(/|$)" NO_CSP=1
SetEnvIf Request_URI "^(/index\.php)?/index/(admin|api)(/|$)" NO_CSP=1
SetEnvIf Request_URI "\$\$\$call\$\$\$" NO_CSP=1
Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'" env=!NO_CSP
</IfModule>

# --- static assets: ONE hour for all of them (clients revalidate with the ETag afterwards). OJS appends ?v=<OJS version>, never the
#     theme version, to theme CSS and JS, and theme images carry no version, so a theme update keeps its URL. LiteSpeed on the host
#     ignored a more specific rule in plugins/themes/.htaccess (Day-0 run, 2026-11-10), so there is one rule for everything. ---
<IfModule mod_expires.c>
ExpiresActive On
# One line per type (ExpiresByType): on the host a FilesMatch + ExpiresDefault rule was ignored and the host's own 7-day default won,
# while ExpiresByType worked (Day-0 t09 and the live check, 2026-11-11).
ExpiresByType text/css "access plus 1 hour"
ExpiresByType text/javascript "access plus 1 hour"
ExpiresByType application/javascript "access plus 1 hour"
ExpiresByType application/x-javascript "access plus 1 hour"
ExpiresByType image/png "access plus 1 hour"
ExpiresByType image/jpeg "access plus 1 hour"
ExpiresByType image/gif "access plus 1 hour"
ExpiresByType image/webp "access plus 1 hour"
ExpiresByType image/avif "access plus 1 hour"
ExpiresByType image/svg+xml "access plus 1 hour"
ExpiresByType image/x-icon "access plus 1 hour"
ExpiresByType image/vnd.microsoft.icon "access plus 1 hour"
ExpiresByType font/woff2 "access plus 1 hour"
ExpiresByType font/woff "access plus 1 hour"
ExpiresByType font/ttf "access plus 1 hour"
ExpiresByType font/otf "access plus 1 hour"
ExpiresByType application/font-woff "access plus 1 hour"
ExpiresByType application/font-woff2 "access plus 1 hour"
ExpiresByType application/vnd.ms-fontobject "access plus 1 hour"
</IfModule>

RewriteEngine On

# --- 1. one canonical form: https on the main host (www and unknown hosts redirect too) ---
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !=@@HOST@@ [NC]
RewriteRule ^ https://@@HOST@@%{REQUEST_URI} [R=301,L]

# --- 2. /index.php/worj/about -> /worj/about, only for GET and HEAD (a 301 turns a POST into a GET).
#        Matched on THE_REQUEST, so the internal rewrite in rule 7 does not loop. The query string is kept. ---
RewriteCond %{THE_REQUEST} ^(GET|HEAD)\ /index\.php(/[^?\ ]*)?(\?[^\ ]*)?\ HTTP/
RewriteRule ^index\.php(?:/(.*))?$ https://@@HOST@@/$1 [R=301,L]

# --- 3. nothing hidden is ever served (.well-known is allowed) ---
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

# --- 4. only index.php runs PHP: any other script (also one uploaded into public/) is a 404, never run, never shown ---
RewriteRule ^index\.php(/|$) - [L]
RewriteRule \.(php[0-9]?|phtml|pht|phar)(/|$) - [R=404,L]

# --- 5. configuration, templates, backups and source-like files, from any directory ---
RewriteRule (^|/)config(\.TEMPLATE)?\.inc\.php$ - [NC,R=404,L]
RewriteRule \.(tpl|inc|bak|old|orig|save|swp|sql|log|env|ini|dist|lock|sh|md|po|pot|yml|yaml)$ - [NC,R=404,L]
RewriteRule (^|/)(composer\.json|composer\.lock|package(-lock)?\.json|Makefile)$ - [NC,R=404,L]

# --- 6. directories that hold code or private data ---
# lib/pkp/lib/vendor is NOT denied as a directory: the admin UI loads TinyMCE and Plupload from it.
RewriteRule ^(cache|tools|dbscripts|registry|docs|classes|controllers|pages|jobs|schemas|templates|locale|plugins/[^/]+/[^/]+/(classes|templates|locale|schema|filter|controllers))(/|$) - [R=404,L]
RewriteRule ^lib/pkp/(classes|controllers|pages|templates|schemas|locale|tools|registry|docs|jobs|xml|plugins/[^/]+/[^/]+/(classes|templates))(/|$) - [R=404,L]

# --- 7. everything that is not a real file is an OJS route (restful_urls = On); directories never list ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php/$1 [L,QSA]
